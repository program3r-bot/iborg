# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── MySQL (MySQL 8.0) ─────────────────────────────────────────────────────────
# FreeHostia: set DB_HOST=localhost, DB_PORT=3306 (default)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_database_name
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── SMTP (FreeHostia: mbox.freehostia.com:465, TLS) ──────────────────────────
SMTP_HOST=mbox.freehostia.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="iborg Dating <your_email@yourdomain.com>"

# ── App ──────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ── FTPS Deployment (FreeHostia: ftps5.us.freehostia.com) ────────────────────
# Run: npm run deploy
FTP_HOST=ftps5.us.freehostia.com
FTP_PORT=21
FTP_USER=your_ftp_username
FTP_PASSWORD=your_ftp_password
# Remote directory on the server where files should be uploaded
FTP_REMOTE_DIR=/public_html
