# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── MySQL / FreeHostia ─────────────────────────────────────────
# FreeHostia's actual MySQL server address (as shown in phpMyAdmin).
# Use 10.123.0.78 (TCP/IP) instead of "localhost" on FreeHostia shared hosting.
DB_HOST=10.123.0.78
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ── SMTP / FreeHostia mail ─────────────────────────────────────
SMTP_HOST=mbox.freehostia.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@yourdomain.com
SMTP_PASS=your_smtp_password
MAIL_FROM=your_email@yourdomain.com

# ── Session ───────────────────────────────────────────────────
SESSION_SECRET=replace_with_a_long_random_string
