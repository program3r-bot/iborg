# ============================================================
# iborg Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# MySQL Database (cp.freehostia.com hosting values)
# In FreeHostia, find these under: Control Panel > MySQL Databases
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# JWT
# Generate a strong random secret, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_random_secret_string
JWT_EXPIRES_IN=7d

# FreeHostia (cp.freehostia.com) Hosting Configuration
# Set FREEHOSTIA_MODE=true when deploying to cp.freehostia.com
# When true, the app adapts connection settings for FreeHostia's MySQL setup.
FREEHOSTIA_MODE=false
FREEHOSTIA_DOMAIN=your-site.freehostia.com
